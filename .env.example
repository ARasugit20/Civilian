# Copy to .env.local — never commit real secrets.

# InsForge (see lib/insforge.js)
NEXT_PUBLIC_INSFORGE_BASE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Anthropic (analyze, moderate, translate)
ANTHROPIC_API_KEY=

# Analyze rate limit (per IP, in-memory per server instance)
ANALYZE_RATE_LIMIT_MAX=8
ANALYZE_RATE_LIMIT_WINDOW_MS=60000

# Maps (codebase uses NEXT_PUBLIC_MAPBOX_TOKEN in several places)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Email
RESEND_API_KEY=

# NextAuth (Google sign-in)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: TinyFish follow-up agent
# TINYFISH_API_KEY=
