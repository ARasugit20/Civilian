# Copy to .env.local — never commit real secrets.

# InsForge (see lib/insforge.js)
NEXT_PUBLIC_INSFORGE_BASE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Anthropic (analyze, moderate, translate)
ANTHROPIC_API_KEY=

# Analyze rate limit (per IP, in-memory per server instance)
ANALYZE_RATE_LIMIT_MAX=8
ANALYZE_RATE_LIMIT_WINDOW_MS=60000

# InsForge read timeout for feed/API queries (ms); falls back to seeded posts on timeout
INSFORGE_READ_TIMEOUT_MS=4000
# InsForge write timeout for post inserts (ms); default 7000 keeps POST under Vercel 10s limit with geocoding
INSFORGE_WRITE_TIMEOUT_MS=7000

# Vercel: set NEXT_PUBLIC_INSFORGE_* (anon key only — never admin/service keys) for Production + Preview, then redeploy.
# After deploy, GET /api/health returns { ok: true } in production (set HEALTH_VERBOSE=1 for host/errors).

# Preview only: expose raw DB errors in /api/posts 503 detail — remove after debugging
# DEBUG_ERRORS=1

# Maps (codebase uses NEXT_PUBLIC_MAPBOX_TOKEN in several places)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Email
RESEND_API_KEY=

# NextAuth (Google sign-in)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: TinyFish follow-up agent
# TINYFISH_API_KEY=
